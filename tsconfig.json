{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "typeRoots": ["./npm/node_modules/@types"],
    "types": ["node"],
    "paths": {
      "@earendil-works/pi-coding-agent": [
        "/run/current-system/sw/lib/node_modules/@earendil-works/pi-coding-agent/dist/index.d.ts"
      ],
      "@earendil-works/pi-tui": [
        "/run/current-system/sw/lib/node_modules/@earendil-works/pi-coding-agent/node_modules/@earendil-works/pi-tui/dist/index.d.ts"
      ]
    }
  },
  "include": ["**/*.ts"],
  "exclude": [".git", ".pi", "npm", "npm-cache", "agent/git", "agent/sessions"]
}
