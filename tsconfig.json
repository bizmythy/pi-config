{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "typeRoots": ["./bun/node_modules/@types"],
    "types": ["node", "bun"],
    "paths": {
      "@earendil-works/pi-coding-agent": [
        "./bun/typecheck/node_modules/@earendil-works/pi-coding-agent/dist/index.d.ts"
      ],
      "@earendil-works/pi-ai": [
        "./bun/typecheck/node_modules/@earendil-works/pi-ai/dist/index.d.ts"
      ],
      "@earendil-works/pi-tui": [
        "./bun/typecheck/node_modules/@earendil-works/pi-tui/dist/index.d.ts"
      ]
    }
  },
  "include": ["**/*.ts"],
  "exclude": [".git", ".pi", "bun", "agent/git", "agent/sessions"]
}
